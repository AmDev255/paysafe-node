{
  "name": "paysafe-tz",
  "version": "0.1.0",
  "description": "Official Node.js SDK (JavaScript and TypeScript) for the PaySafe payments API (Tanzania mobile money, refunds, control numbers, payment links, transfers, webhooks)",
  "keywords": [
    "paysafe",
    "payments",
    "tanzania",
    "mobile-money",
    "mpesa",
    "tigopesa",
    "airtel-money",
    "api",
    "sdk",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://paysafe.co.tz/docs",
  "bugs": "https://github.com/AmDev255/paysafe-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmDev255/paysafe-node.git"
  },
  "license": "MIT",
  "author": "PaySafe",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.3"
  }
}
